+def test_openrouter_caps_the_host_price_and_records_the_billed_cost(monkeypatch):
+    # The screen's DeepSeek voter is routed away from output-expensive hosts, and
+    # what OpenRouter billed is recorded as reported — never estimated.
+    monkeypatch.setattr(llm, "OPENROUTER_API_KEY", "or-test")
+    recorded: list = []
+    monkeypatch.setattr(llm, "_record_tokens", lambda *a: recorded.append(a))
+    served = _resp('{"ok": true}')
+    served.usage = MagicMock(prompt_tokens=2400, completion_tokens=800, cost=0.00015)
+    served.usage.prompt_tokens_details = MagicMock(cached_tokens=2048,
+                                                   cache_write_tokens=0)
+    fake_client = MagicMock()
+    fake_client.chat.completions.create.return_value = served
+    with patch("openai.OpenAI", return_value=fake_client):
+        assert llm.call_openrouter("p", model="deepseek/deepseek-v4-flash")[0] == {"ok": True}
+        llm.call_openrouter("p", model="v/m")
+
+    first, other = (c.kwargs["extra_body"]
+                    for c in fake_client.chat.completions.create.call_args_list)
+    assert first["provider"]["max_price"] == {"completion": 0.3}
+    assert first["usage"] == {"include": True}
+    assert "max_price" not in other["provider"]          # only the named model
+    assert recorded[0] == ("openrouter", "deepseek/deepseek-v4-flash",
+                           2400, 800, 2048, 0, 0.00015)
 
 

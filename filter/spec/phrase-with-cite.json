          },
          {
            "text_regex": "\\b(?:(?:d(?:oes|o|id)|w(?:as|ere)|is|are|ha[sd]|have|could|would|should|can|may|might)\\s+(?:not|never)|cannot|can['’]t)\\s+(?:(?:be|been)\\s+)?replicat\\w+\\b"
          },
          {
            "text_regex": "\\b(?:unable|inabilit\\w+|failure)\\s+to\\s+replicate\\b"
          },
          {

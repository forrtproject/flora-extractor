{
  "id": "phrase-reproduction",
  "description": "The nine reproduction-anchored patterns (_REPRODUCTION_ANCHORED). Anchored on purpose: a bare \"reproduction of\" matches animal breeding, social reproduction and epidemiological R0 far more often than a reproduction study (8% precision over 15,440 corpus rows; 0 of 15 sampled bare hits were our sense, #137), while these forms cost nothing and score better on the curated reproduction list.",
  "match": {
    "any_of": [
      {
        "text_regex": "\\breproductions? of ['\\\"\u201c\u2018]"
      },
      {
        "text_regex": "\\breproductions? of\\s+(?:the\\s+)?(?:(?:original|published|reported|previous|prior|main|key|core)\\s+)?(?:results?|findings?|analys[ei]s|estimates?|figures?|tables?|stud(?:y|ies)|experiments?|data)\\b"
      },
      {
        "text_regex": "\\bcomput\\w*\\s+reproduc\\w+\\b"
      },
      {
        "text_regex": "\\brobustness\\s+(?:replicabilit\\w+|reproducibilit\\w+|replication)\\b"
      },
      {
        "text_regex": "\\breproduc\\w+\\s+(?:and|&)\\s+(?:replicat|extend|extension)\\w*\\b"
      },
      {
        "text_regex": "\\bre-?analy[sz](?:is|es|ed|ing|e)\\s+of\\b"
      },
      {
        "text_regex": "\\bre-?analyz\\w+\\b"
      },
      {
        "text_regex": "\\breproduc(?:e|es|ed|ing)\\s+(?:\\w+ly\\s+)?(?:the\\s+)?(?:original|published|reported|previous|prior|main|key|core|their|these|authors'?)?\\s*(?:results?|findings?|estimates?|figures?|tables?|analys[ei]s)\\b"
      },
      {
        "text_regex": "\\b(?:fail\\w*|unable|inabilit\\w+|attempt\\w*|sought|seek\\w*|aim\\w*|tr(?:y|ies|ied|ying))\\s+to\\s+reproduce\\b"
      },
      {
        "text_regex": "\\bwe\\s+(?:\\w+ly\\s+)?reproduced?\\b"
      }
    ]
  },
  "pile": "screen_cheap",
  "vocabulary": "reproduction",
  "precedence": 262,
  "shadow": false,
  "measured": []
}

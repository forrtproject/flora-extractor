                "text_regex": "\\b(?:data|code|scripts?|files?|materials?|repositor\\w+|replication package)\\b[^.\\n]{0,200}\\b(?:available|provided|deposited|archived|posted|shared|supplement\\w*|repositor\\w+|osf|github|dataverse|zenodo|figshare|doi\\.org)\\b"

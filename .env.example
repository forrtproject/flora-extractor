# FLoRA Extractor — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Your email address — included in API request headers for OpenAlex and Crossref
# (required for polite pool access, higher rate limits)
RESEARCHER_EMAIL=you@example.com

# Gemini API key — primary LLM (free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_key_here

# ── Optional but recommended ──────────────────────────────────────────────────

# Additional Gemini API keys, tried in order when one returns 429.
# Add as many as you have — keys must be sequential (2, 3, 4, …).
# The pipeline stops loading at the first missing slot, so never leave gaps.
# NOTE: Gemini rate limits are applied PER PROJECT, not per key, so extra keys
# from the same project do NOT raise your quota — they only cover a revoked or
# misconfigured key. Throughput comes from enabling billing (Tier 1), which
# lifts the heavy model from 20 to 10,000 requests/day.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=  (keep adding as needed — no code changes required)

# OpenAI API key — REQUIRED for Stage 3 with the default SCREEN_VOTER2_MODEL
# (gpt-5.4-mini is called on OpenAI direct), and the middle rung of the linking ladder.
OPENAI_API_KEY=

# OpenAlex API key — optional, recommended for Stage 3.
# Without it: polite pool via mailto= parameter — works fine for normal usage.
# With it: higher rate limits + authenticated access to content.openalex.org
# (the GROBID XML endpoint used by Tier 0 PDF acquisition in Stage 3).
# Get one at https://openalex.org or via your institution's OpenAlex access.
OPENALEX_API_KEY=

# Further OpenAlex keys, used in rotation. OpenAlex bills per request against a
# per-key daily budget that resets at midnight UTC, so a long Stage 3 run can drain
# one key mid-run and the client moves to the next on a budget refusal. Give either a
# comma-separated list or numbered slots (2…9); duplicates are dropped.
# OPENALEX_API_KEYS=key_one,key_two
# OPENALEX_API_KEY_2=

# Semantic Scholar API key (Stage 1). SEMANTIC_SCHOLAR_KEY is accepted as an alias.
S2_API_KEY=

# SerpAPI keys — Google Scholar tier of the PDF acquisition waterfall. Optional;
# without them that tier is skipped. The second key takes over on 429/quota errors.
SERPAPI_KEY=
SERPAPI_KEY_2=

# Elsevier Scopus API key — optional abstract-backfill tier (Stage 1 fetch_abstracts
# Phase 4). Backfills abstracts by DOI via the Scopus Abstract Retrieval API.
# Weekly quota is ~10,000 requests; fetch_abstracts caps a run with --scopus-limit
# (default 9000) so one run cannot exhaust it. Get a key at https://dev.elsevier.com.
ELSEVIER_API_KEY=
# Elsevier institutional token — needed when Scopus rejects the key from off-campus.
# ELSEVIER_INSTTOKEN=

# OpenRouter API key — the last provider in the linking ladder (Gemini → OpenAI →
# OpenRouter), so it answers when both of the others fail. Get a key at openrouter.ai —
# free credits available. It is also REQUIRED for Stage 3 if you point
# SCREEN_VOTER2_MODEL at an OpenRouter model id (one containing "/").
OPENROUTER_API_KEY=

# OpenRouter model for linking (default: qwen/qwen3.5-35b-a3b)
# OPENROUTER_HEAVY_MODEL=qwen/qwen3.5-35b-a3b

# Second voter of the front-door replication screen (default: gpt-5.4-mini, called on
# OpenAI direct; a model id containing "/" is routed to OpenRouter instead). Stage 3
# decides whether a paper is a replication at all by voting Gemini and this model
# against each other, so extract.run_extract refuses to start without GEMINI_API_KEY
# and whichever of OPENAI_API_KEY / OPENROUTER_API_KEY this model needs (unless
# --no-llm is set). Both voters' model names are part of the screen's cache key, so
# changing this makes the affected rows re-vote by itself — there is no version
# constant to bump.
# SCREEN_VOTER2_MODEL=gpt-5.4-mini

# ── Supabase (validation monitoring) ─────────────────────────────────────────
# URL and service-role key for the Supabase project used by the validation repo.
# Used by the dashboard's Validation tab — leave empty to hide that tab.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Optional infrastructure ───────────────────────────────────────────────────

# GROBID server URL — used for reference extraction from PDFs
# Run locally: docker run -t --rm -p 8070:8070 lfoppiano/grobid:0.8.0
# Leave empty to skip GROBID (PDF reference extraction will be limited)
GROBID_URL=http://localhost:8070

# ── Model names ───────────────────────────────────────────────────────────────
# Primary Gemini model — used for all LLM calls unless overridden below
# Default: gemini-3-flash-preview
# GEMINI_MODEL=gemini-3-flash-preview

# Heavy model: used for DOI resolution and match-type classification (complex reasoning)
# Default: same as GEMINI_MODEL
# GEMINI_HEAVY_MODEL=gemini-3-flash-preview

# Light model: cheap, high rate limits. Voter 1 of the front-door replication screen
# and the default model of the provider ladder when no model is named.
# Default: gemini-3.5-flash-lite
# GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite

# OpenAI models
# Default: gpt-5-mini
# OPENAI_MODEL=gpt-5-mini

# ── Gemini flex inference ─────────────────────────────────────────────────────
# Flex costs 50% less than standard — the same discount as Batch, with no batch
# plumbing — but calls may queue for up to 15 minutes. Paid (billing-enabled)
# keys only; it is applied to every Gemini call, including the PDF and image ones.
# GEMINI_USE_FLEX=true
# GEMINI_FLEX_TIMEOUT=900   # seconds; 900 = 15 minutes (Google's stated maximum)
# Which key slots are paid, by 1-based number (GEMINI_API_KEY = 1, GEMINI_API_KEY_2 = 2, …).
# Flex is applied only on these keys; free-tier keys fall back to standard inference.
# GEMINI_PAID_KEYS=1

# ── Rate limits (seconds between calls) ───────────────────────────────────────
# Each LLM interval is charged per provider, against that provider's own last-call
# timestamp: the screen's two votes go to different providers and neither waits on
# the other. Raise a value if a provider starts returning 429s.
# GEMINI_RATE_SEC=1.0
# OPENAI_RATE_SEC=0.5
# OPENROUTER_RATE_SEC=0.5
# OPENALEX_RATE_SEC=0.3
# Europe PMC (search/fetch_abstracts.py) is keyless and public — keep this polite.
# EPMC_RATE_SEC=0.4

# ── Daily token budget ────────────────────────────────────────────────────────
# Hard ceiling on tokens bought per calendar day, across every provider. The running
# total is kept in cache/token_budget.json, so it survives a restart and is shared by
# concurrent runs; once it is reached the pipeline stops cleanly instead of calling
# again. Set to 0 to lift the cap — that is the only way to disable it.
# DAILY_TOKEN_BUDGET=8000000

# ── Outcome extraction ────────────────────────────────────────────────────────
# The outcome step classifies from the ABSTRACT by default. When the abstract LLM
# returns cannot_be_determined (or there is no abstract) and parsed fulltext is
# available, it escalates to a second, fulltext-based LLM call. Set to false to
# turn the escalation off (abstract-only). Default: true.
# OUTCOME_FULLTEXT_ESCALATION=true

# ── Cache location (fix for slow disks) ────────────────────────────────────────
# cache/ holds hundreds of thousands of small per-identifier files. Random reads of
# pre-existing files scattered across one huge flat directory are a classic bad case
# for a spinning hard disk (each read costs a real seek) — measured ~80x slower than
# an SSD on a 798k-file cache directory, enough to stall a large abstract/PDF backfill
# for hours before it shows any progress. If your repo checkout sits on an HDD, point
# this at a directory on an SSD instead; leave unset for the default (cache/ inside
# the repo).
# FLORA_CACHE_DIR=C:/flora-cache

# ── Monitoring app ────────────────────────────────────────────────────────────
# Flask session key. The default is a fixed development string — set a real value
# for any deployment reachable by anyone else.
# FLASK_SECRET_KEY=

# FLORA_READONLY=1 registers only the dashboard and check pages, skipping the
# blueprints that import the heavy PDF dependencies (pdfminer, pymupdf, playwright).
# Use it for read-only hosting where those packages are not installed.
# FLORA_READONLY=1

# ── Stage 1 opt-ins ───────────────────────────────────────────────────────────
# FLORA_USE_ENGINE=1 adds the search-engine source to Stage 1, on top of (never
# instead of) the OpenAlex fetch.
# FLORA_USE_ENGINE=1

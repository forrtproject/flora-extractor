[Unit]
Description=Harvest new I4R Discussion Papers into FLoRA's candidate pool
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Coding/flora-extractor
ExecStart=%h/Documents/Coding/flora-extractor/.venv/bin/python -m search.i4r --write
MemoryMax=2G
MemorySwapMax=0

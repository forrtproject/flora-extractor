# FLoRA Extractor — shared, non-secret environment settings. COMMITTED to git.
#
# What belongs here: values every collaborator must have IDENTICAL, that carry no
# secret and that the code cannot sensibly default on its own — project and repo
# identifiers pointing at the shared infrastructure.
#
# What does NOT belong here:
#   - Secrets. API keys, tokens and service-role keys live in .env (gitignored);
#     .env.example lists their names.
#   - Anything shared/config.py already defaults. Every tunable — models, rate
#     limits, batch sizes, flags — has its default and its rationale in config.py,
#     and restating one here would create two committed sources of truth that can
#     silently disagree. Override those per-machine in .env, not here.
#   - Personal settings: RESEARCHER_EMAIL, FLORA_CACHE_DIR, flex flags. Those are
#     yours, not the project's — .env.
#
# Precedence (shared/config.py loads .env first, then this file, and python-dotenv
# never overwrites a variable that is already set):
#     real environment  >  .env  >  .env.defaults  >  the default in config.py

# Supabase project holding the validation tables and the filter engine's state
# authority (claims, permanent verdicts, audit). The URL is not a credential; the
# service-role key that goes with it is, and stays in .env. Read directly with
# os.getenv() in several modules — where "unset" means "no state authority
# configured" — so it has to arrive as an environment variable, not a constant.
SUPABASE_URL=https://nvosftsulqbfyphwoxvv.supabase.co

# Private Hugging Face dataset repo the Stage 1 survivor pool and its text overlay
# are shared through, so a collaborator pulls the pool instead of re-running a
# 13-21 hour scan and routes under the same overlay hash, and so the API caches
# (shared/cache_sync.py, cache/ prefix) are shared too. Access needs HF_TOKEN
# from .env.
FLORA_POOL_REPO=lukaswallrich/flora-survivor-pool
